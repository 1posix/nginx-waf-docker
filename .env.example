# nginx-waf-docker V2
COMPOSE_PROJECT_NAME=nginx-waf
TZ=Europe/Paris

# Host bind addresses and ports
WAF_BIND_IP=0.0.0.0
HTTP_PORT=80
# HTTPS is opt-in. See examples/nginx/sites/https-example.conf
HTTPS_PORT=443

# Image name used for local builds
WAF_IMAGE=nginx-waf
WAF_VERSION=2.0.3

# Runtime UID/GID baked into the image.
# scripts/setup.sh prepares writable directories for this identity.
WAF_UID=10001
WAF_GID=10001
